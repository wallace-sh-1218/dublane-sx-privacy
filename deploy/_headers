# Security defaults for every response.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# HTML is revalidated so a redeploy takes effect immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Media and screenshots never change under the same name. guide.css / guide.js
# are deliberately left out: they are not content-hashed, so they must expire.
/help/assets/brand/*
/help/assets/shots/*
/help/assets/video/*
/help/assets/cases/*
  Cache-Control: public, max-age=31536000, immutable
